# Security Operations Agent Environment Configuration

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# PostgreSQL Database
DATABASE_URL=postgresql://secops_user:secops_password@localhost:5432/secops_db

# Threat Intel APIs
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# LLM Configuration (e.g. OpenAI / Anthropic / Local Ollama)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# SIEM Integration (Wazuh / Splunk / Elastic / Sentinel)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_VERIFY_SSL=false

# Escalation (Slack / Webhook)
SLACK_WEBHOOK_URL=
